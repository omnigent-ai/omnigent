OMNIGENT_DISCORD_BOT_TOKEN=your-bot-token
# Must be https:// for any real host — the per-user delegated token rides on
# every request, so plaintext is refused. http:// is allowed only for loopback
# (localhost / 127.0.0.1 / ::1) during local testing.
OMNIGENT_SERVER_URL=https://omnigent.example.com

# Optional runtime tuning
# LOG_LEVEL=INFO
# Where the bot's SQLite store lives. Defaults to
# $OMNIGENT_DATA_DIR/omnigent_discord.sqlite3 (or
# ~/.omnigent/omnigent_discord.sqlite3 when OMNIGENT_DATA_DIR is unset).
# OMNIGENT_DISCORD_DATABASE_PATH=

# Comma- or space-separated guild (server) ids the bot will act in. Anyone with
# Manage Server can add a Discord bot to a guild, so set this to the guild(s)
# you actually run in and messages from anywhere else are ignored outright.
# Leave unset to act in every guild the bot has been added to.
# OMNIGENT_DISCORD_GUILD_IDS=

# OPT-IN fast-iteration override for where /omnigent is registered. Left unset
# (the default) the command is published globally, which is what makes it work
# in DMs — Discord routes DM interactions only to global commands. Setting this
# registers per-guild instead: it appears within seconds, but /omnigent then
# does NOT exist in DMs, including `/omnigent new`, the only way to end a DM
# session. The bot warns at startup when you are in this mode.
# OMNIGENT_DISCORD_COMMAND_GUILD_IDS=

# Seconds between edits of the live streaming reply. Discord has no streaming
# message API, so the reply is one message edited in place; edits are
# rate-limited per channel. 1.0 reads as live and stays inside the limit. Raise
# it on a busy bot. Accepted range: 0.25–10.
# OMNIGENT_DISCORD_STREAM_EDIT_INTERVAL=1.0

# Optional but strongly recommended: shared secret from the Omnigent server.
# Set it to the SAME value as the Omnigent server's
# OMNIGENT_DEVICE_CLIENT_SECRET; the bot then sends it on the device
# authorize/token/revoke calls (X-Omnigent-Client-Secret header) so the server
# only accepts this client. Leave unset when the server doesn't require it.
# Only meaningful in accounts mode (the OIDC flow doesn't use it).
# OMNIGENT_DEVICE_CLIENT_SECRET=

# The bot auto-detects the server's auth mode (via GET /v1/me, like the
# `omnigent login` CLI) and picks the matching login flow — no auth-mode config
# here:
#   • accounts → OAuth 2.0 device grant (a consent page in the browser).
#                Requires the Omnigent server to have the device grant enabled
#                (OMNIGENT_DEVICE_GRANT_ENABLED=1 on the server — it is
#                default-off), otherwise accounts-mode login can't complete.
#   • oidc     → the server's cli-login ticket flow (the user signs in at your
#                IdP; no device grant, no refresh token)
#   • header   → not supported by this integration. A proxy-authenticated
#                server asserts identity from a request header the bot cannot
#                produce from a gateway event. Run the server in accounts/oidc
#                mode, or put the bot behind the same identity proxy.
# The Omnigent server's own OMNIGENT_OIDC_* / OMNIGENT_AUTH_* env vars decide
# its mode; the bot needs none of them.

# A Fernet key that encrypts each user's delegated token at rest so a stolen
# database file can't impersonate them — generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, tokens are kept in memory only (never written to disk) and lost on
# restart, so users re-authenticate; the integration still works.
# OMNIGENT_DISCORD_TOKEN_ENCRYPTION_KEY=

# Read files that users attach to their messages. Off by default: turning this
# on lets anyone who can reach the bot put a file on the host running their
# agent. Users approve the upload itself the first time they send a file.
# OMNIGENT_DISCORD_ALLOW_FILE_UPLOAD=true
# OMNIGENT_DISCORD_MAX_ATTACHMENT_BYTES=8388608
# OMNIGENT_DISCORD_MAX_ATTACHMENTS=5
