apiVersion: v1
kind: Namespace
metadata:
  name: omnigent-runners
---
apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: omnigent
  namespace: omnigent-runners
  labels:
    workload: omnigent
spec:
  replicas: 1
  workerImage: ghcr.io/agent-substrate/substrate/ateworker-gvisor@sha256:f8987236c6256f58c4b2625e543b43f4ae4bdded6ee6821c03d966effb7c0f17
  sandboxClasses:
    - name: gvisor
  template:
    nodeSelector:
      kubernetes.io/arch: REPLACE_WITH_IMAGE_ARCHITECTURE
    resources:
      limits:
        cpu: "4"
        memory: 6Gi
