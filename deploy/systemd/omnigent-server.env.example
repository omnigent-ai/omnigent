# Omnigent server — EnvironmentFile template for the systemd unit.
#
# Install to /etc/omnigent/omnigent-server.env. It holds secrets, so:
#   sudo install -d -m 0750 -o root -g omnigent /etc/omnigent
#   sudo install -m 0640 -o root -g omnigent omnigent-server.env.example \
#        /etc/omnigent/omnigent-server.env
#
# systemd parses this itself -- it is NOT a shell script. No `export`, no
# quoting rules, no variable interpolation: write KEY=value, one per line.
#
# The unit references it as `EnvironmentFile=-/etc/omnigent/...`; the
# leading `-` means a missing file is not an error, so the loopback
# default below works with this file absent entirely.

# ── Paths ────────────────────────────────────────────────────────────
# Where the sqlite db (chat.db), artifacts, and the accounts cookie
# secret live. Must match StateDirectory=omnigent in the unit.
#
# Caveat: this does NOT relocate the CLI diagnostic logs. Those go to
# $HOME/.omnigent/logs/ regardless (state_dir() is hardcoded to
# Path.home()/".omnigent"), which is why the unit pins HOME=/var/lib/omnigent.
OMNIGENT_DATA_DIR=/var/lib/omnigent

# Optional YAML config file (admins, allowed_domains, policies, sandbox).
# Defaults to <data_dir>/config.yaml. See deploy/docker/config.yaml.example.
# OMNIGENT_CONFIG=/etc/omnigent/config.yaml

# Optional: extend the graceful-shutdown drain window (default 30s).
# If you raise this, raise TimeoutStopSec in the unit to match.
# OMNIGENT_SERVER_SHUTDOWN_TIMEOUT_S=30

# ─────────────────────────────────────────────────────────────────────
# AUTH — everything below is REQUIRED if you change the unit's
# --host to anything other than 127.0.0.1.
#
# With the default loopback bind and no auth vars set, the server runs
# single-user with identity "local" and no login. That is the only
# configuration that works unauthenticated.
#
# On a non-loopback bind the server still BOOTS, but it does not enable
# the single-user fallback, so auth resolves to `header` mode and every
# request without an X-Forwarded-Email header is rejected with 401. An
# exposed server with no auth configured is therefore not "open" -- it is
# simply unusable. Pick one of the three modes below.
# ─────────────────────────────────────────────────────────────────────

# Master switch. Turn this on for any non-loopback bind.
# OMNIGENT_AUTH_ENABLED=1
#
# Explicit escape hatch that pins the mode and bypasses the
# auto-selection below: accounts | oidc | header.
# OMNIGENT_AUTH_PROVIDER=accounts

# ── Mode A: built-in accounts (username + password) ───────────────────
# Selected when OMNIGENT_AUTH_ENABLED=1 and no OIDC issuer is set.
# Username/password with a first-run admin bootstrap and UI invites.
# No external IdP needed -- the simplest way to expose the server.
#
# 32-byte hex cookie secret. Generate with: openssl rand -hex 32
# Auto-generated into <data_dir>/accounts-cookie-secret if unset, but set
# it explicitly for a stable value across data-dir wipes.
# OMNIGENT_ACCOUNTS_COOKIE_SECRET=<64-hex-chars>
#
# The public URL the BROWSER uses (behind your TLS proxy), not the
# 127.0.0.1:6767 address. Required for any deploy behind a domain --
# it builds the magic-redeem URLs and decides on __Host- cookies.
# OMNIGENT_ACCOUNTS_BASE_URL=https://omnigent.example.com
#
# Seed the first-run admin password non-interactively. Only takes effect
# on the very first boot of the accounts DB. The unit is headless, so
# without this (or the web Create-admin form) there is no TTY to prompt on.
# OMNIGENT_ACCOUNTS_INIT_ADMIN_PASSWORD=
#
# Optional TTLs. Defaults shown.
# OMNIGENT_ACCOUNTS_SESSION_TTL_HOURS=8
# OMNIGENT_ACCOUNTS_INVITE_TTL_HOURS=72
# OMNIGENT_ACCOUNTS_MAGIC_TTL_MINUTES=10

# ── Mode B: OIDC (your own IdP) ───────────────────────────────────────
# Selected when OMNIGENT_AUTH_ENABLED=1 and OMNIGENT_OIDC_ISSUER is set --
# the issuer is what flips the mode; there is no separate provider flag.
# Requires HTTPS (the session cookie uses the __Host- prefix).
#
# Set OMNIGENT_DOMAIN rather than a redirect URI: the server derives
# https://<OMNIGENT_DOMAIN>/auth/callback. Register that exact URL in
# your IdP.
# OMNIGENT_DOMAIN=omnigent.example.com
# OMNIGENT_OIDC_ISSUER=https://accounts.google.com
# OMNIGENT_OIDC_CLIENT_ID=...
# OMNIGENT_OIDC_CLIENT_SECRET=...
# OMNIGENT_OIDC_COOKIE_SECRET=<64-hex-chars>
# OMNIGENT_OIDC_SCOPES=openid email profile
# OMNIGENT_OIDC_ALLOWED_DOMAINS=example.com
# OMNIGENT_OIDC_ALLOW_INVITES=1
# OMNIGENT_OIDC_SESSION_TTL_HOURS=8

# ── Mode C: header proxy ──────────────────────────────────────────────
# Only if you already run a trusted SSO proxy (oauth2-proxy, Cloudflare
# Access, an ALB/OIDC listener) that injects X-Forwarded-Email on every
# request AND STRIPS any client-supplied copy. If the proxy does not
# strip it, anyone can impersonate anyone by sending the header.
# OMNIGENT_AUTH_PROVIDER=header
