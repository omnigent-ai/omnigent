#!/bin/sh
# Host-aware git credential helper for managed sandboxes.
#
# Installed as git's --system `credential.helper` (see deploy/docker/Dockerfile,
# `host` target). On each HTTPS auth challenge git runs this with the operation
# as $1 and the request (host=, protocol=, ...) on stdin.
#
# It answers from environment credentials, resolved PER HOST so a sandbox that
# talks to more than one git host (e.g. github.com AND a self-hosted Forgejo)
# gives each host its own token instead of spraying a single token at all of
# them:
#
#   1. A host-specific pair, if set:
#        GIT_TOKEN_<HOST>      / GIT_USERNAME_<HOST>
#      <HOST> is the request host upcased with every non-alphanumeric byte
#      turned into `_`, e.g. git.joyful.house -> GIT_TOKEN_GIT_JOYFUL_HOUSE.
#   2. Otherwise the shared GIT_TOKEN / GIT_USERNAME (the original single-host
#      behaviour — unchanged for deployments that set only those).
#
# GIT_USERNAME defaults to x-access-token (GitHub's token-auth username; GitLab
# users set oauth2). Emits nothing (declines, so git tries the next helper or
# clones anonymously) when no token resolves — public clones stay untouched.
#
# The per-user GitHub broker (omnigent/git_credential_github.py) stays
# authoritative for github.com: it is wired as a --global helper and the
# github.com helper chain is reset there, so this --system helper is bypassed
# for github.com whenever the owner has GitHub connected.
#
# Pure POSIX sh with no runtime dependency on the venv, because it runs for
# every git operation in the sandbox — including the workspace-prep clone.

# Only `get` returns credentials; store/erase are no-ops (nothing is persisted).
[ "$1" = get ] || exit 0

host=
while IFS='=' read -r key value; do
	case "$key" in
	host) host=$value ;;
	'') break ;;
	esac
done

# Upcase and replace every non-alphanumeric byte with `_`; the result is only
# [A-Z0-9_], so it is safe to interpolate into the env var name below.
suffix=$(printf '%s' "$host" | tr 'a-z' 'A-Z' | tr -c 'A-Z0-9' '_')

# The username pairs with whichever token wins: a host-specific token takes its
# username from GIT_USERNAME_<HOST> (else the x-access-token default), never from
# the shared GIT_USERNAME — that one belongs to the shared GIT_TOKEN and pairing
# it with a different host's token would be a latent auth bug.
token=$(printenv "GIT_TOKEN_$suffix")
if [ -n "$token" ]; then
	username=$(printenv "GIT_USERNAME_$suffix")
	[ -n "$username" ] || username=x-access-token
else
	token=$GIT_TOKEN
	username=${GIT_USERNAME:-x-access-token}
fi

[ -n "$token" ] || exit 0
printf 'username=%s\npassword=%s\n' "$username" "$token"
