+def test_run_turn_emits_executor_error_on_nonzero_exit(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A non-zero exit code surfaces as :class:`ExecutorError`.
+
+    Without this branch a silent failure would land in the AP REPL
