{
  "description": "Every workflow must be classified here. Real model workflows use explicit pipeline tags on gateway requests. Mock test lanes retain their own labels but make no paid calls. Review transport and callers when adding or changing a model consumer.",
  "model_workflows": {
    "auto-assign-reviewer.yml": {
      "pipeline": "auto-assign-reviewer",
      "transport": "urllib chat_request -> mlflow/v1/chat/completions"
    },
    "doc-sync.yml": {
      "pipeline": "doc-sync",
      "transport": "Claude classifier and drafter -> anthropic/v1/messages"
    },
    "draft-release-notes.yml": {
      "pipeline": "draft-release-notes",
      "transport": "run-omnigent-agent -> anthropic/v1/messages"
    },
    "feature-blog.yml": {
      "pipeline": "feature-blog",
      "transport": "run-omnigent-agent selector and native drafter -> anthropic/v1/messages; urllib image chat -> mlflow/v1/chat/completions"
    },
    "flake-stress-e2e.yml": {
      "pipeline": "flake-stress-e2e",
      "transport": "Live test fixtures; native Claude/Codex, OpenAI Agents SDK, DatabricksExecutor and policy adapters -> protocol-specific gateway"
    },
    "issue-prioritization-v2.yml": {
      "pipeline": "${{ inputs.pipeline }}",
      "transport": "Authenticated Databricks SDK API client -> mlflow/v1/chat/completions; required caller input keeps issue-triage and needs-info-response separate"
    },
    "issue-triage.yml": {
      "pipeline": "issue-triage",
      "transport": "Legacy native Claude -> anthropic/v1/messages; reusable triage_v2 -> mlflow/v1/chat/completions"
    },
    "needs-info-response.yml": {
      "pipeline": "needs-info-response",
      "transport": "Reusable triage_v2 -> mlflow/v1/chat/completions"
    },
    "open-code-review.yml": {
      "pipeline": "open-code-review",
      "transport": "OCR extra-headers -> anthropic/v1/messages"
    },
    "polly-review.yml": {
      "pipeline": "polly-review",
      "transport": "Native coordinator and workers -> anthropic/v1/messages and codex/v1/responses; usage-attribution-probe job exercises all three protocols"
    },
    "publish-changelog.yml": {
      "pipeline": "publish-changelog",
      "transport": "run-omnigent-agent -> anthropic/v1/messages"
    },
    "security-triage.yml": {
      "pipeline": "security-triage",
      "transport": "Native Claude -> anthropic/v1/messages"
    },
    "vscode-release-pr.yml": {
      "pipeline": "vscode-release-pr",
      "transport": "urllib chat_request -> mlflow/v1/chat/completions"
    }
  },
  "mock_workflows": {
    "e2e.yml": "e2e",
    "e2e-ui.yml": "e2e-ui",
    "integration.yml": "integration",
    "server-compat.yml": "server-compat",
