{
  "name": "omnigent-desktop-electron",
  "productName": "Omnigent",
  "version": "0.12.0",
  "description": "Omnigent desktop shell (Electron edition) \u2014 a thin native wrapper around the server-served web UI.",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://omnigent.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/omnigent-ai/omnigent.git"
  },
  "author": {
    "name": "Databricks, Inc.",
    "email": "support@omnigent.ai"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac:release": "OMNIGENT_NOTARIZE_DMG=true electron-builder --mac -c.mac.notarize=true -c.dmg.sign=true",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:overlay": "pnpm --filter web run build:overlay && pnpm --filter web run build:server-selector-v2",
    "predev": "pnpm run build:overlay",
    "prestart": "pnpm run build:overlay",
    "prebuild": "pnpm run build:overlay",
    "prebuild:mac": "pnpm run build:overlay",
    "prebuild:mac:release": "pnpm run build:overlay",
    "prebuild:linux": "pnpm run build:overlay",
    "prebuild:win": "pnpm run build:overlay"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.0.0",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "ai.omnigent.desktop",
    "productName": "Omnigent",
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Omnigent session link",
        "schemes": [
          "omnigent"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://omnigent.ai/_desktop/updates/"
      }
    ],
    "afterPack": "build/afterPack.js",
    "afterAllArtifactBuild": "build/afterAllArtifactBuild.js",
    "files": [
      "src/**/*",
      "about/**/*",
      "setup/**/*",
      "arca-connect/**/*",
      "server-selector-v2/**/*",
      "find/**/*",
      "return-banner/**/*",
      "icons/**/*",
      "overlay/**/*"
    ],
    "extraResources": [
      {
        "from": "../platform-assets",
        "to": "platform-assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon.icns",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "identity": "Databricks, Inc. (8RMX4WU6F8)",
      "hardenedRuntime": true,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Omnigent uses the microphone for voice dictation in the message composer.",
        "CFBundleIconName": "AppIcon",
        "NSPrefersDisplaySafeAreaCompatibilityMode": false
      },
      "gatekeeperAssess": false,
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://omnigent.ai/_desktop/updates/"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "background": "dmg/background.tiff",
      "window": {
        "width": 640,
        "height": 465
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 170,
          "y": 100
        },
        {
          "x": 470,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Development",
      "maintainer": "Databricks, Inc. <support@omnigent.ai>",
      "target": [
        "AppImage",
        "deb"
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://omnigent.ai/_desktop/updates/"
        }
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis"
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://omnigent.ai/_desktop/updates/"
        }
      ]
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.3.0"
  }
}
