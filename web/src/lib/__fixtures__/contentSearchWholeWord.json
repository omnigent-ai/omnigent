    },
    {
      "name": "plain word, ignoring case",
      "query": "needle",
      "regex": false,
      "caseSensitive": false,
      "wholeWord": true,
      "pattern": "\\bneedle\\b",
      "sentRegex": true,
      "lines": [1, 3, 6, 7, 19]
    },
    {
      "name": "whole word off keeps a substring search",
      "query": "needle",
      "regex": false,
      "caseSensitive": true,
      "wholeWord": false,
      "pattern": "needle",
      "sentRegex": false,
      "lines": [1, 2, 3, 4, 5, 6, 13, 19]
    },
    {
      "name": "composed accent",
      "query": "café",
      "regex": false,
      "caseSensitive": true,
      "wholeWord": true,
      "pattern": "\\bcaf(?:[\\x{E9}&&\\w]\\b|[\\x{E9}&&\\W])",
      "sentRegex": true,
      "lines": [8]
    },
    {
      "name": "decomposed accent",
      "query": "cafe\u0301",
      "regex": false,
