<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Edge-to-edge is driven in code (WindowCompat.setDecorFitsSystemWindows).
      The cutout mode lets the WebView extend into the display cutout so
      injected safe-area insets cover notched devices.
    -->
    <style name="Theme.Omnigent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- The bars are transparent over the (light) web UI, so their icons
             must be dark or the clock/status icons vanish white-on-white.
             The night variant flips these back to light icons. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- DeepLinkActivity: forwards and finishes in one frame, so it should
         never actually be seen — translucent avoids a visible flash if a
         frame does render before finish() takes effect. -->
    <style name="Theme.Omnigent.Translucent" parent="Theme.Omnigent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
