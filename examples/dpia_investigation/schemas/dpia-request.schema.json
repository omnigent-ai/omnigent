{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnigent.example/dpia/dpia-request.schema.json",
  "title": "DPIA Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "request_id", "requester", "project", "known_unknowns", "submitted_at"],
  "properties": {
    "artifact": { "const": "dpia-request" },
    "request_id": { "type": "string", "pattern": "^req-[a-z0-9][a-z0-9-]{2,60}$" },
    "requester": { "$ref": "#/$defs/party" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "purpose", "data_subjects", "personal_data", "vendors", "timeline"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "purpose": { "type": "string", "minLength": 10 },
        "data_subjects": { "type": "string", "minLength": 3 },
        "personal_data": { "type": "string", "minLength": 3 },
        "vendors": { "type": "string", "minLength": 1 },
        "timeline": { "type": "string", "minLength": 1 }
      }
    },
    "known_unknowns": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "submitted_at": { "type": "string", "minLength": 10 }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "team"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "team": { "type": "string", "minLength": 2 }
      }
    }
  }
}
