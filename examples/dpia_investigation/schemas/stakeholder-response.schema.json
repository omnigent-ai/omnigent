{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnigent.example/dpia/stakeholder-response.schema.json",
  "title": "DPIA Stakeholder Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "case_id", "respondent", "answers", "submitted_at"],
  "properties": {
    "artifact": { "const": "stakeholder-response" },
    "case_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "respondent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "team"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "team": { "type": "string", "minLength": 2 }
      }
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "response"],
        "properties": {
          "question_id": { "type": "string", "minLength": 1 },
          "response": { "type": "string", "minLength": 10 }
        }
      }
    },
    "submitted_at": { "type": "string", "minLength": 10 }
  }
}
